generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ModelType {
  CHAT
  REASONING
  EMBEDDING
  IMAGE
  AUDIO
  CODE
}

enum Modality {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
}

enum BenchmarkCategory {
  GENERAL
  REASONING
  CODING
  MATH
  MULTIMODAL
}

model Lab {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  country     String
  founded     Int
  website     String
  description String
  openWeights Boolean  @default(false)
  models      Model[]
  createdAt   DateTime @default(now())
}

model Provider {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  website     String
  description String
  region      String
  offerings   ProviderModel[]
  createdAt   DateTime        @default(now())
}

model Model {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  labId         String
  lab           Lab               @relation(fields: [labId], references: [id], onDelete: Cascade)
  type          ModelType
  description   String
  releaseDate   DateTime
  contextWindow Int
  maxOutput     Int
  parameters    String?
  openWeights   Boolean           @default(false)
  inputModalities  Modality[]
  outputModalities Modality[]
  capabilities  String[]
  // Reference list pricing, USD per 1M tokens (lowest-priced provider is derived from offerings)
  inputPrice    Decimal?          @db.Decimal(10, 4)
  outputPrice   Decimal?          @db.Decimal(10, 4)
  providers     ProviderModel[]
  scores        BenchmarkScore[]
  createdAt     DateTime          @default(now())

  @@index([labId])
  @@index([type])
  @@index([releaseDate])
  @@index([inputPrice])
  @@index([contextWindow])
}

model ProviderModel {
  id          String   @id @default(cuid())
  modelId     String
  providerId  String
  model       Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputPrice  Decimal? @db.Decimal(10, 4)
  outputPrice Decimal? @db.Decimal(10, 4)
  latencyMs   Int
  throughput  Int // tokens/sec
  uptime      Decimal  @db.Decimal(5, 2)

  @@unique([modelId, providerId])
  @@index([providerId])
}

model Benchmark {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  category    BenchmarkCategory
  description String
  maxScore    Int               @default(100)
  scores      BenchmarkScore[]
}

model BenchmarkScore {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  score       Float
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([modelId, benchmarkId])
  @@index([benchmarkId, score])
}
